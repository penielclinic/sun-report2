# Supabase (새 프로젝트) — Project Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 로그인 PIN 을 Supabase 비밀번호로 바꿀 때 섞는 서버 전용 비밀값 (아무 긴 문자열)
AUTH_PIN_SECRET=change-me-to-a-long-random-string

# Vercel Cron 인증 (미제출 리마인더)
CRON_SECRET=change-me-too

# (선택) AI 목회 브리핑 — Anthropic API 키가 있을 때만 동작
ANTHROPIC_API_KEY=

NEXT_PUBLIC_APP_NAME=순보고
NEXT_PUBLIC_CHURCH_NAME=해운대순복음교회
